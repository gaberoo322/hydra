[Unit]
Description=Hourly Hydra stale test temp-dir reaper (2026-10-31 inode exhaustion)
Documentation=https://github.com/gaberoo322/hydra/issues/5329

[Timer]
# Hourly, like hydra-test-proc-reaper.timer. The 12h --max-age cutoff (whole subtree) in the
# service ensures a temp dir a running test still uses is never touched.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
