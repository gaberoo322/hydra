[Unit]
Description=Hydra failure notification for %i

[Service]
Type=oneshot
# Credentials arrive only via EnvironmentFile — never inline Environment=
# literals in this tracked file (issue #4284). %h/hydra/.env is the same
# untracked file hydra-orchestrator.service already loads, and it already
# holds TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID. Deliberately NOT dash-prefixed:
# a missing .env must fail this notifier loudly in the journal instead of
# silently sending nothing.
EnvironmentFile=%h/hydra/.env
# Operator Channel CLI (ADR-0045 Decision 6, issue #5046): same renderer,
# dedup and credentials as in-process pages, applies the exit-code policy
# (a clean SIGTERM never pages) and the unit -> page/brief map, and works
# while the orchestrator is down. /usr/bin/node + strip-types only — a
# unit's minimal PATH cannot see a global tsx. The CLI exits 0 for every
# delivery outcome; TimeoutStartSec is the outer bound on a hung dependency.
ExecStart=/usr/bin/node --experimental-strip-types %h/hydra/scripts/operator-notify.ts service-failed --unit %i
TimeoutStartSec=30
Environment=HOME=/home/gabe
