+export function flatFieldsToRecord(flat: string[]): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (let i = 0; i < flat.length - 1; i += 2) out[flat[i]] = flat[i + 1];
+  return out;
+}
 
