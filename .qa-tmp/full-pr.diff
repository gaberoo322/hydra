+/** Result of one `gh` / `git` invocation. Never throws. */
+export type CmdResult =
+  | { ok: true; stdout: string; stderr?: string }
+  | { ok: false; stderr: string; stdout?: string };
+
+export interface HttpResult {
+  status: number;
+  body: string;
