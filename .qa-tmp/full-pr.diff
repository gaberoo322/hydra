+export interface AdvanceResult {
+  rc: number;
+  /** The refusal / outcome `code` from the CLI JSON ("" when absent). */
+  code: string;
+  /** `wouldPark` (shadow-mode cap report) from the CLI JSON ("" when absent). */
+  wouldPark: string;
