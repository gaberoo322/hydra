+    let sized: PreflightResult["fanout"] | null = null;
+    try {
+      const out = await ports.phase("fanout", { pr: prNumber, tier: tierNum, changedPaths });
+      if (
+        (out.mode === "single" || out.mode === "standard" || out.mode === "adversarial") &&
+        Array.isArray(out.reviewers)
